APP_NAME=nlp-fin
DEBUG=false
LOG_LEVEL=INFO

DATA_DIR=./data
RAW_DIR=./data/raw
PROCESSED_DIR=./data/processed
CHUNKS_DIR=./data/chunks
ANNOTATIONS_DIR=./data/annotations
MODELS_DIR=./data/models
DICTIONARIES_DIR=./data/dictionaries

OCR_TESSERACT_CMD=
OCR_TESSERACT_LANG=rus
OCR_TESSDATA_PREFIX=
OCR_PSM=4
OCR_OEM=1
OCR_IMAGE_DPI=300
PDF_TEXT_MIN_CHARS=50
PDF_SAMPLE_PAGES=3

CHUNK_MAX_WORDS=128
CHUNK_OVERLAP_RATIO=0.05
NOISE_REPEAT_RATIO=0.7
NOISE_HEADER_ZONE=0.05
NOISE_FOOTER_ZONE=0.95
NER_TOKENIZER=ai-forever/rubert-base-cased
NER_MAX_LENGTH=128
NER_EPOCHS=6
NER_BATCH_SIZE=16
NER_GRAD_ACCUMULATION=4
NER_LEARNING_RATE=2e-05
NER_WARMUP_RATIO=0.06
NER_PATIENCE=2
RISK_MAX_LENGTH=256
RISK_EPOCHS=6
RISK_BATCH_SIZE=16
RISK_GRAD_ACCUMULATION=4
RISK_LEARNING_RATE=2e-05
RISK_WARMUP_RATIO=0.06
RISK_PATIENCE=2
RISK_DROPOUT=0.3